using Microsoft.EntityFrameworkCore;
using TarjetaSUBE;

namespace CobrarSaldosNegativoYPositivoTests
{
	public class CobrarSaldosNegativoYPositivoTests
	{
		private TarjetaSUBEContext _db = null!;
		private Tarjeta_tipo _tipo = null!;
		private Tarjeta _tarjeta = null!;

		[SetUp]
		public void Setup()
		{
			var opciones = new DbContextOptionsBuilder<TarjetaSUBEContext>()
				.UseInMemoryDatabase(Guid.NewGuid().ToString())
				.Options;

			_db = new TarjetaSUBEContext(opciones);
			Contexto.Db = _db;

			_tipo = new Tarjeta_tipo
			{
				id_Tipo = 1,
				nombre_Tipo = "Tarifa general",
				porcentaje_pago = 100
			};
			_db.Tarjeta_tipos.Add(_tipo);
			_db.SaveChanges();

			_tarjeta = new Tarjeta(0, _tipo.id_Tipo)
			{
				Tipo = _tipo
			};
		}

		[TearDown]
		public void TearDown()
		{
			_db.Dispose();
		}

		[Test]
		public void CobrarPasajeConSaldoNegativo()
		{
			_tarjeta.Cargar(2000);
			_tarjeta.Cobrar(1580);
			_tarjeta.Cobrar(2420);

			Assert.That(_tarjeta.Saldo, Is.EqualTo(-2000));
			Assert.That(() => _tarjeta.Cobrar(1), Throws.TypeOf<ArgumentException>());
			Assert.That(_tarjeta.Saldo, Is.EqualTo(-2000));
		}

		[Test]
		public void CobrarPasajeConSaldoPositivo()
		{
			_tarjeta.Cargar(2000);

			var tarjetaGuardada = _db.Tarjetas.Single();

			Assert.That(tarjetaGuardada, Is.SameAs(_tarjeta));
			Assert.That(_tarjeta.Cobrar(1580), Is.SameAs(_tarjeta));
			Assert.That(_tarjeta.Saldo, Is.EqualTo(420));
		}
    }
}


